{
  "name": "junction0",
  "display_name": "Junction0",
  "description": "Rust-powered Linux with unified bus, process unification, intelligent resource management, and containerized driver isolation.",
  "base_image": "arch-rolling",
  "use_case": "Desktop",
  "hardware": {
    "platform": "pc",
    "architecture": "x86_64",
    "gpu": null,
    "min_cpu_cores": 2,
    "min_memory_gb": 4,
    "min_storage_gb": 16,
    "nic_count": 1
  },
  "os": {
    "features": ["ssh"],
    "packages": [
      "rust",
      "cargo",
      "base-devel",
      "linux-headers",
      "dbus",
      "udev",
      "polkit",
      "git",
      "cmake",
      "ninja"
    ],
    "custom_packages": [
      {
        "name": "junction0-busd",
        "git_url": "https://github.com/GenesisProjectZA/junction0-busd.git",
        "branch": "main"
      },
      {
        "name": "junction0-pid",
        "git_url": "https://github.com/GenesisProjectZA/junction0-pid.git",
        "branch": "main"
      },
      {
        "name": "junction0-res",
        "git_url": "https://github.com/GenesisProjectZA/junction0-res.git",
        "branch": "main"
      },
      {
        "name": "junction0-drv",
        "git_url": "https://github.com/GenesisProjectZA/junction0-drv.git",
        "branch": "main"
      }
    ],
    "users": [
      {
        "username": "junction0",
        "full_name": "Junction0 User",
        "groups": ["sudo", "wheel", "audio", "video", "input"],
        "shell": "/bin/bash"
      }
    ],
    "services": [
      {
        "name": "junction0-busd",
        "enabled": true,
        "config": {}
      },
      {
        "name": "junction0-pid",
        "enabled": true,
        "config": {}
      },
      {
        "name": "junction0-res",
        "enabled": true,
        "config": {}
      },
      {
        "name": "junction0-drv",
        "enabled": true,
        "config": {}
      },
      {
        "name": "sshd",
        "enabled": true,
        "config": {
          "port": 22,
          "disable_password_auth": true
        }
      }
    ],
    "security": {
      "hardening_level": "standard"
    },
    "installer": {
      "enabled": false
    },
    "startup_scripts": [
      {
        "name": "junction0-init-bus",
        "description": "Initialize Junction0 unified bus",
        "command": "mkdir -p /run/junction0 && junction0-busd --init || true",
        "packages": ["junction0-busd"],
        "run_as": "root",
        "after": "network.target"
      },
      {
        "name": "junction0-init-pid",
        "description": "Start process unification watcher",
        "command": "junction0-pid --daemon || true",
        "packages": ["junction0-pid"],
        "run_as": "root",
        "after": "junction0-init-bus.service"
      },
      {
        "name": "junction0-init-res",
        "description": "Start resource manager",
        "command": "junction0-res --daemon || true",
        "packages": ["junction0-res"],
        "run_as": "root",
        "after": "junction0-init-pid.service"
      },
      {
        "name": "junction0-init-drv",
        "description": "Initialize driver system",
        "command": "junction0-drv --init || true",
        "packages": ["junction0-drv"],
        "run_as": "root",
        "after": "junction0-init-res.service"
      }
    ]
  },
  "scenarios": [
    {
      "id": "junction0-smoke",
      "name": "Junction0 Smoke Test",
      "enabled": true,
      "tests": ["boot", "login"],
      "custom_tests": [
        {
          "description": "Verify Junction0 binaries are installed",
          "assertions": [
            {
              "type": "command_succeeds",
              "description": "junction0-busd runs",
              "params": {"command": "junction0-busd --version"}
            },
            {
              "type": "command_succeeds",
              "description": "junction0-pid runs",
              "params": {"command": "junction0-pid --version"}
            },
            {
              "type": "command_succeeds",
              "description": "junction0-res runs",
              "params": {"command": "junction0-res --version"}
            },
            {
              "type": "command_succeeds",
              "description": "junction0-drv runs",
              "params": {"command": "junction0-drv --version"}
            }
          ]
        },
        {
          "description": "Verify bus is listening",
          "assertions": [
            {
              "type": "port_listening",
              "description": "junction0-busd on port 9553",
              "params": {"port": 9553, "protocol": "tcp"}
            }
          ]
        },
        {
          "description": "Verify Rust toolchain",
          "assertions": [
            {
              "type": "command_succeeds",
              "description": "rustc available",
              "params": {"command": "rustc --version"}
            },
            {
              "type": "command_succeeds",
              "description": "cargo available",
              "params": {"command": "cargo --version"}
            }
          ]
        }
      ]
    }
  ],
  "publish_to": ["local"]
}
